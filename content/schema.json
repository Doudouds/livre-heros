{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:portes-imaginaire:content:v2",
  "title":"Arc ou collection de scènes — Les Portes de l'Imaginaire",
  "oneOf":[{"$ref":"#/$defs/arc"},{"$ref":"#/$defs/scene_bundle"}],
  "$defs":{
    "condition":{
      "type":"object","additionalProperties":false,
      "properties":{
        "all":{"type":"array","items":{"$ref":"#/$defs/condition"}},
        "any":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/condition"}},
        "not":{"$ref":"#/$defs/condition"},
        "hero":{"type":"string"},"item":{"type":"string"},"location":{"type":"string"},
        "flag":{"type":"string"},"ally":{"type":"string"},"inventory":{"type":"string"},
        "min_success":{"type":"integer","minimum":0},
        "min_complication":{"type":"integer","minimum":0},
        "min_failure":{"type":"integer","minimum":0}
      }
    },
    "strings":{"type":"array","items":{"type":"string","minLength":1}},
    "effects":{
      "type":"object","additionalProperties":false,
      "properties":{
        "set_flags":{"$ref":"#/$defs/strings"},"unset_flags":{"$ref":"#/$defs/strings"},
        "add_allies":{"$ref":"#/$defs/strings"},"remove_allies":{"$ref":"#/$defs/strings"},
        "add_inventory":{"$ref":"#/$defs/strings"},"remove_inventory":{"$ref":"#/$defs/strings"},
        "visit_locations":{"$ref":"#/$defs/strings"},"meet_characters":{"$ref":"#/$defs/strings"},
        "add_enemies":{"$ref":"#/$defs/strings"},"events":{"$ref":"#/$defs/strings"}
      }
    },
    "modifier":{
      "type":"object","required":["label","when","delta"],"additionalProperties":false,
      "properties":{"label":{"type":"string","minLength":1},"when":{"$ref":"#/$defs/condition"},
        "delta":{"type":"number","minimum":-1,"maximum":1}}
    },
    "outcome":{
      "type":"object","required":["text","next"],"additionalProperties":false,
      "properties":{"text":{"type":"string","minLength":1},"next":{"type":"string","minLength":1},
        "effects":{"$ref":"#/$defs/effects"},"audio_file":{"type":["string","null"]}}
    },
    "choice":{
      "type":"object","required":["id","text","base_success","outcomes"],"additionalProperties":false,
      "properties":{
        "id":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},
        "base_success":{"type":"number","minimum":0,"maximum":1},
        "complication_share":{"type":"number","minimum":0,"maximum":1},
        "modifiers":{"type":"array","items":{"$ref":"#/$defs/modifier"}},
        "effects":{"$ref":"#/$defs/effects"},
        "outcomes":{"type":"object","required":["success","complication","failure"],"additionalProperties":false,
          "properties":{"success":{"$ref":"#/$defs/outcome"},"complication":{"$ref":"#/$defs/outcome"},"failure":{"$ref":"#/$defs/outcome"}}}
      }
    },
    "choices":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/choice"}},
    "variant":{
      "type":"object","required":["id","when"],"additionalProperties":false,
      "properties":{"id":{"type":"string","minLength":1},"when":{"$ref":"#/$defs/condition"},
        "text":{"type":"string","minLength":1},"append":{"type":"string","minLength":1},
        "choices":{"$ref":"#/$defs/choices"},"effects":{"$ref":"#/$defs/effects"},
        "values":{"type":"object","additionalProperties":{"type":"string"}}}
    },
    "scene":{
      "type":"object","required":["id","arc","kind","rank","act","title","text"],"additionalProperties":false,
      "properties":{
        "id":{"type":"string","minLength":1},"arc":{"type":"string","minLength":1},
        "kind":{"enum":["intro","decision","ending"]},"rank":{"type":"integer","minimum":0},
        "act":{"type":"integer","minimum":1,"maximum":5},"title":{"type":"string","minLength":1},
        "text":{"type":"string","minLength":1},"next":{"type":"string","minLength":1},
        "ending":{"type":"string","minLength":1},"choices":{"$ref":"#/$defs/choices"},
        "conditions":{"$ref":"#/$defs/condition"},"effects":{"$ref":"#/$defs/effects"},
        "variants":{"type":"array","items":{"$ref":"#/$defs/variant"}},
        "audio_file":{"type":["string","null"]}
      },
      "allOf":[
        {"if":{"properties":{"kind":{"const":"intro"}}},"then":{"required":["next"],"not":{"required":["choices"]}}},
        {"if":{"properties":{"kind":{"const":"decision"}}},"then":{"required":["choices"]}},
        {"if":{"properties":{"kind":{"const":"ending"}}},"then":{"required":["ending"],"not":{"anyOf":[{"required":["choices"]},{"required":["next"]}]}}}
      ]
    },
    "scene_bundle":{"type":"object","required":["scenes"],"additionalProperties":false,
      "properties":{"scenes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/scene"}}}},
    "arc":{
      "type":"object","required":["id","title","description","decision_count","start","revelations","endings"],"additionalProperties":false,
      "properties":{
        "id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"description":{"type":"string"},
        "conditions":{"$ref":"#/$defs/condition"},"decision_count":{"type":"integer","minimum":11,"maximum":13},
        "item_overrides":{"type":"object","additionalProperties":{"type":"object","additionalProperties":{"type":"string"}}},
        "hero_overrides":{"type":"object","additionalProperties":{"type":"object","additionalProperties":{"type":"string"}}},
        "location_overrides":{"type":"object","additionalProperties":{"type":"object","additionalProperties":{"type":"string"}}},
        "text_values":{"type":"object","additionalProperties":{"type":"string"}},
        "inline_consequences":{"type":"boolean"},
        "start":{"type":"string","minLength":1},
        "revelations":{"type":"array","minItems":1,"items":{"type":"object","required":["id","actor","text"],"additionalProperties":false,
          "properties":{"id":{"type":"string"},"actor":{"type":"string"},"text":{"type":"string"}}}},
        "endings":{"type":"array","minItems":1,"items":{"type":"object","required":["scene","when"],"additionalProperties":false,
          "properties":{"scene":{"type":"string"},"when":{"$ref":"#/$defs/condition"}}}}
      }
    }
  }
}
